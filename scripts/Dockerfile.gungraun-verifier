# Upstream toolchain digest is immutable. This image is built only in CI
# prefetch (network allowed there), never inside the offline verifier itself.
FROM docker.io/library/rust@sha256:f6c4a35d21dbb3c89d7a8d056c193e94fc09037f2b58dd858b09c39a47dd02d7
RUN cargo install --locked --version 0.20.0 gungraun-runner \
    && gungraun-runner --version | grep -F '0.20.0'
