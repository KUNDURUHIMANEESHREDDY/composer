# Frozen upstream nightly compiler + exact-date compiler-development components.
# rustup checks signed distribution manifests and component checksums.
FROM docker.io/rustlang/rust@sha256:eb59a92b7f3abf22b62141998ad2f2b477425ccd2f796a1dd87e79bc78beccab
RUN rustup component add rustc-dev llvm-tools-preview \
    && test -n "$(rustc --print sysroot)" \
    && rustc --version

# Syn's upstream tests parse the actual Rust compiler source tree. Prefetch
# that exact public Git revision during image construction; the verifier still
# runs with Docker --network=none, no runtime fetch or hidden test exclusions.
ARG SYN_RUST_REV=b6839f4d0e2bd63b960bbff8619c6fdea27d81e5
RUN set -eux; \
    mkdir -p /opt/composer-syn-rust-source; \
    curl --proto '=https' --tlsv1.2 --fail --location --retry 5 \
      --output /tmp/composer-pinned-rust-source.tar.gz \
      "https://codeload.github.com/rust-lang/rust/tar.gz/${SYN_RUST_REV}"; \
    tar --no-same-owner --no-same-permissions -xzf /tmp/composer-pinned-rust-source.tar.gz \
      --strip-components=1 -C /opt/composer-syn-rust-source; \
    printf '%s\n' "${SYN_RUST_REV}" > /opt/composer-syn-rust-source/COMMIT; \
    test -f /opt/composer-syn-rust-source/compiler/rustc_ast/src/lib.rs; \
    test -d /opt/composer-syn-rust-source/tests/ui; \
    rm -f /tmp/composer-pinned-rust-source.tar.gz
